## Citation year is PINNED to the first-release year (first commit 2021).
## DESCRIPTION has no Date field, so deriving it from meta$Date yielded an
## empty year, and a current-date fallback made the same package version
## cite as a different year every calendar year. Keep this in sync with the
## bibtex block in README.md.
year <- 2026
note <- sprintf("R package version %s", meta$Version)

bibentry(
  bibtype  = "Misc",
  header   = "To cite the cfbplotR R package in publications, use:",
  key      = "lee_gilani_carl_cfbplotR",
  author   = c(
    person("Jared",     "Lee",    email = "13jaredlee@gmail.com"),
    person("Saiem",     "Gilani", email = "saiem.gilani@gmail.com",
           comment = c(ORCID = "0000-0002-7194-9067")),
    person("Sebastian", "Carl",   email = "mrcaseb@gmail.com")
  ),
  title    = "cfbplotR: The SportsDataverse's R Package for College Football Plotting.",
  url      = "https://cfbplotR.sportsdataverse.org",
  year     = year,
  note     = note,
  textVersion = paste0(
    "Jared Lee, Saiem Gilani, and Sebastian Carl (", year, "). ",
    "cfbplotR: The SportsDataverse's R Package for College Football Plotting. ",
    note, ". Retrieved from https://cfbplotR.sportsdataverse.org"
  )
)
